# Copy this file to .env.local and fill in real values.
# .env.local is already ignored by .gitignore ("env files") -- never
# commit real secrets.

# Resend API key (server-only). Get one from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sending address on your Resend domain, e.g.
# "NeoDent Dental Hospitals <enquiries@neodentdentalhospitals.com>"
# Must be on a domain you have verified with Resend -- do NOT use the
# visitor's email address here.
RESEND_FROM_EMAIL=

# The clinic inbox that should receive new website enquiries.
CONTACT_INBOX_EMAIL=

# --- Cloudflare Turnstile (bot/spam protection for the contact form) ---
# Docs: https://developers.cloudflare.com/turnstile/
#
# Public sitekey from the Turnstile widget. Safe to expose -- it is
# inlined into the client bundle at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The widget's secret key (server-only). NEVER prefix this with
# NEXT_PUBLIC_: that would ship it to the browser and let anyone mint
# passing tokens. Only app/api/enquiry/route.ts reads it, via
# lib/turnstile.ts, and it is never logged.
TURNSTILE_SECRET_KEY=

# Optional. Extra hostnames whose solved tokens this site will accept,
# comma-separated -- only needed if the form must work from another host
# (e.g. a Vercel preview domain that has been added to the widget's
# Hostname Management). The production hostnames and loopback hosts are
# already accepted by default.
# TURNSTILE_ALLOWED_HOSTNAMES=

# --- Testing Turnstile locally ----------------------------------------
# A production sitekey only renders on hostnames listed in the widget's
# Hostname Management, so it typically fails on http://localhost:3000.
# Hostname matching is enforced in production builds only, which is what
# lets these test keys work locally. Cloudflare's test keys work on any
# host, including localhost, but must live in .env.local only -- never in
# Vercel/production:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # always passes
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Other useful pairs: 2x00000000000000000000AB / 2x0000000000000000000000000000000AA
# (always fails), and 3x0000000000000000000000000000000AA (reports a spent token).
# A production secret key rejects these dummy tokens, and vice versa.
